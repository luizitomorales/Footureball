# Variáveis de ambiente 
# ============================================================================
# API KEYS (OBRIGATÓRIAS)
# ============================================================================

# Football-Data.org (Free Tier: 10 requests/min)
FOOTBALL_DATA_API_KEY=your_key_here

# The Odds API (Free: 500 requests/month)
ODDS_API_KEY=your_key_here

# API-Football (RapidAPI - tem plano free)
API_FOOTBALL_KEY=your_key_here
API_FOOTBALL_HOST=v3.football.api-sports.io

# ============================================================================
# LLM CONFIGURATION (ESCOLHA UMA OPÇÃO)
# ============================================================================

# Opção 1: OpenAI (Pago, mais preciso)
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4-turbo-preview  # ou gpt-3.5-turbo

# Opção 2: Google Gemini (Free tier disponível)
GOOGLE_AI_API_KEY=your_key_here

# Opção 3: Local Ollama (Gratuito, offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1  # ou mistral, codellama

# ============================================================================
# EMAIL CONFIGURATION (Gmail recomendado)
# ============================================================================

EMAIL_SENDER=seu_email@gmail.com
EMAIL_PASSWORD=senha_app_gerada  # Use App Password, não senha normal
EMAIL_RECIPIENT=lipsf25@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ============================================================================
# DATABASE & CACHE
# ============================================================================

# SQLite (padrão) ou PostgreSQL
DATABASE_URL=sqlite:///data/betting.db

# Redis para cache (opcional)
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# BETTING CONFIGURATION
# ============================================================================

INITIAL_BANKROLL=10000.00
MAX_RISK_PER_BET=0.15  # 15% do bankroll
KELLY_FRACTION=0.25    # 25% do Kelly full
MIN_CONFIDENCE=0.55    # Confiança mínima para apostar

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================

LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo
DEBUG_MODE=False